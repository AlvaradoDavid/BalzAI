# Copia este archivo como .env y ajusta los valores. Todos son opcionales en desarrollo.

ENTORNO=desarrollo

# SQLite (MVP). Para PostgreSQL instala psycopg y usa, por ejemplo:
# DATABASE_URL=postgresql+psycopg://usuario:clave@localhost:5432/parqueos
DATABASE_URL=sqlite:///./parqueos.db

# Obligatorio cambiarlo en producción (p. ej. python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRETO=solo-para-desarrollo-cambiar-en-produccion
JWT_MINUTOS_EXPIRACION=480

# Lista JSON de orígenes permitidos por CORS (solo si el frontend se sirve desde otro dominio)
CORS_ORIGENES=["http://localhost:5173","http://127.0.0.1:5173"]

# Datos de ejemplo (se cargan solo si la base está vacía). En producción: false.
CARGAR_DATOS_EJEMPLO=true
SUPERADMIN_USUARIO=superadmin
SUPERADMIN_CLAVE=balzai2026
ADMIN_USUARIO=admin
ADMIN_CLAVE=parqueos2026
DISPOSITIVO_DEMO_CLAVE=sensor-demo-cuenca
